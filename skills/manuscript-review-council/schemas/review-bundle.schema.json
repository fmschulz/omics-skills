{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manuscript review council bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manuscript_slug", "run_id", "mode", "packet_path", "reviewer_reports", "issues", "conflicts_path", "editor_path", "editor_recommendation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manuscript_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "mode": {"enum": ["critique", "revision_assessment", "rebuttal_assessment"]},
    "packet_path": {"type": "string"},
    "reviewer_reports": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["role", "path", "recommendation", "confidence"], "properties": {"role": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "path": {"type": "string"}, "recommendation": {"enum": ["accept", "minor_revision", "major_revision", "reject"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "conflicts_path": {"type": "string"},
    "editor_path": {"type": "string"},
    "editor_recommendation": {"enum": ["accept", "minor_revision", "major_revision", "reject"]},
    "reduced_council_reason": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "source_roles", "severity", "category", "location", "evidence", "problem", "required_action", "status"],
      "properties": {
        "issue_id": {"type": "string", "pattern": "^ISSUE-[0-9]{3}$"},
        "source_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "severity": {"enum": ["major", "minor"]},
        "category": {"type": "string"},
        "location": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "problem": {"type": "string", "minLength": 1},
        "required_action": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "resolved", "partial", "unresolved"]}
      }
    }
  }
}
