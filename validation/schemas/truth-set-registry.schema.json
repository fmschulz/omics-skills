{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fmschulz/omics-skills/validation/schemas/truth-set-registry.schema.json",
  "title": "Omics biological truth-set registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "drivers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "drivers": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/driver"}
    }
  },
  "$defs": {
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "execution_surface", "truth_sets"],
      "properties": {
        "skill": {"type": "string", "pattern": "^bio-[a-z0-9-]+$"},
        "execution_surface": {
          "enum": ["external-tool-driver", "execution-plan", "artifact-builder"]
        },
        "truth_sets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/truth_set"}
        }
      }
    },
    "truth_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "status", "tier", "source", "truth_basis", "strata",
        "metrics", "limitations", "artifacts"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "status": {"enum": ["candidate", "ready", "deferred"]},
        "tier": {"enum": ["synthetic", "biological-proxy", "empirical"]},
        "source": {"$ref": "#/$defs/source"},
        "truth_basis": {"type": "string", "minLength": 20},
        "strata": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metric"}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 20}
        },
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ready"}}},
          "then": {
            "properties": {
              "artifacts": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "checksum": {
                      "properties": {
                        "algorithm": {"const": "sha256"},
                        "value": {"pattern": "^[0-9a-f]{64}$"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "release", "license"],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "doi": {"type": "string", "pattern": "^10\\."},
        "release": {"type": "string", "minLength": 2},
        "license": {"type": "string", "minLength": 3}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "unit"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "direction": {"enum": ["maximize", "minimize", "report"]},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "upstream_checksum"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "upstream_checksum": {"type": ["string", "null"]},
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"enum": ["sha256"]},
            "value": {"type": "string"}
          }
        }
      }
    }
  }
}
