{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fmschulz/omics-skills/validation/schemas/run-evidence.schema.json",
  "title": "Scheduler validation run evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "validation_id", "driver", "truth_set_id", "job_id",
    "scheduler", "outputs", "scientific_metrics", "failure_modes"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "validation_id": {"type": "string"},
    "driver": {"type": "string"},
    "truth_set_id": {"type": "string"},
    "job_id": {"type": "string", "minLength": 1},
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cluster", "state", "exit_code", "elapsed_seconds", "peak_rss_bytes", "allocated_cpus", "requested_memory", "nodes"],
      "properties": {
        "cluster": {"type": "string", "minLength": 1},
        "state": {"type": "string"},
        "exit_code": {"type": "string"},
        "elapsed_seconds": {"type": "integer", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "allocated_cpus": {"type": "integer", "minimum": 1},
        "requested_memory": {"type": "string"},
        "nodes": {"type": "string"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "passed"],
        "properties": {
          "path": {"type": "string"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "scientific_metrics": {"type": "object"},
    "failure_modes": {"type": "array", "items": {"type": "string"}}
  }
}
